<?xml version="1.0" encoding="utf-8"?>
<!--
  Confirmation de démarrage.

  Structure volontairement plate : un titre, la réponse à « où ? », le nom
  exact du fichier, puis les raccourcis de dossier. Pas de ScrollView
  inutile, pas de hiérarchie imbriquée — un dialogue qui demande un effort
  de lecture n'est pas lu.

  Les couleurs sont RÉFÉRENCÉES (@color/…), jamais écrites en dur : elles
  doivent changer entre le mode clair et le mode sombre. Une valeur
  littérale figée rendrait ce dialogue illisible dès que l'utilisateur
  choisit l'autre thème — c'était le cas de la v5.4, corrigé ici.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_confirm_body"
        android:textColor="@color/gps_text_dim"
        android:textSize="13sp"
        android:paddingBottom="4dp" />

    <!-- LE CHEMIN, EN CLAIR. C'est l'élément le plus important du
         dialogue : la réponse à la question que se posent tous les
         utilisateurs. monospace pour qu'il se lise caractère par
         caractère, sélectionnable pour qu'on puisse le copier. -->
    <TextView
        android:id="@+id/tvStartWhere"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/gps_text"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textIsSelectable="true"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/tvStartFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/gps_text_dim"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textIsSelectable="true"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/tvStartNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/gps_text_dim"
        android:textSize="11sp"
        android:textStyle="italic"
        android:paddingBottom="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dest_section"
        android:textColor="@color/gps_text_dim"
        android:textSize="11sp"
        android:paddingTop="4dp"
        android:paddingBottom="2dp" />

    <!-- Les boutons de dossier sont ajoutés par le code : leur nombre et leur
         libellé viennent de Destination.PRESETS, une seule source de vérité.
         Les dupliquer ici les ferait diverger. -->
    <LinearLayout
        android:id="@+id/llDestPresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
