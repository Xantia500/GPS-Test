<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gps_bg">

    <!-- ============ BARRE DE STATUT ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_waiting"
            android:textColor="@color/gps_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!--
          BANDEAU D'ÉTAT PERMANENT (v5.10)

          Quatre champs de LARGEUR MINIMALE FIXE, en texte tabulaire : sans
          cela, la ligne se décale à chaque changement de chiffre et le
          regard doit la rescanner à chaque seconde.

          Seul l'état du fix change de couleur (vert 3D / ambre 2D / rouge
          aucun). Une ligne multicolore est une ligne qu'on n'apprend pas.

          maxLines=1 + ellipsize : sur un écran étroit, on préfère tronquer
          proprement plutôt que casser la ligne en deux et perdre la lecture
          d'un coup d'œil.
        -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <TextView
                android:id="@+id/tvHudClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:gravity="end"
                android:maxLines="1"
                android:fontFamily="monospace"
                android:textColor="@color/gps_text_dim"
                android:textSize="11sp"
                android:paddingEnd="6dp" />

            <TextView
                android:id="@+id/tvHudFix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="52dp"
                android:gravity="center"
                android:maxLines="1"
                android:fontFamily="monospace"
                android:textColor="@color/gps_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingEnd="6dp" />

            <TextView
                android:id="@+id/tvHudSats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="76dp"
                android:gravity="end"
                android:maxLines="1"
                android:fontFamily="monospace"
                android:textColor="@color/gps_text_dim"
                android:textSize="11sp"
                android:paddingEnd="6dp" />

            <TextView
                android:id="@+id/tvHudBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="44dp"
                android:gravity="end"
                android:maxLines="1"
                android:fontFamily="monospace"
                android:textColor="@color/gps_text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_start"
            android:backgroundTint="@color/gps_green_dim"
            android:textColor="@color/gps_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/btn_reset"
            android:backgroundTint="@color/gps_card"
            android:textColor="@color/gps_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <!--
      Note affichée UNIQUEMENT quand une session enregistre et que la
      réception n'est pas valide. Sans elle, l'utilisateur voit une trace
      « en cours » et une position grisée : il peut croire que
      l'enregistrement continue. C'est le malentendu le plus coûteux de
      l'application — une trace à laquelle on ne peut pas se fier.
    -->
    <TextView
        android:id="@+id/tvSignalNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/signal_relost_hint"
        android:textColor="@color/gps_warn"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- ============ BARRE D'OUTILS SECONDAIRE ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btnMap"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/menu_map"
            android:textSize="11sp"
            android:backgroundTint="@color/gps_card"
            android:textColor="@color/gps_green" />

        <Button
            android:id="@+id/btnAgps"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/btn_agps"
            android:textSize="11sp"
            android:backgroundTint="@color/gps_card"
            android:textColor="@color/gps_amber" />

        <Button
            android:id="@+id/btnGpx"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/btn_gpx_start"
            android:textSize="11sp"
            android:backgroundTint="@color/gps_card"
            android:textColor="@color/gps_green" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/btn_settings"
            android:textSize="11sp"
            android:backgroundTint="@color/gps_card"
            android:textColor="@color/gps_text_dim" />

        <Button
            android:id="@+id/btnExpert"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/btn_expert"
            android:textSize="11sp"
            android:backgroundTint="@color/gps_card"
            android:textColor="@color/gps_red" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
        android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <!-- ============ POSITION ============ -->
            <TextView style="@style/SectionTitle" android:text="@string/section_position" />

            <!--
              GROUPE GRISABLE.

              Tout ce bloc passe à 35 % d'opacité quand le signal n'est plus
              valide : position, vitesse, cap, précision, distance. L'objectif
              est qu'un coup d'œil suffise — l'utilisateur ne doit JAMAIS
              pouvoir lire une position comme « actuelle » alors qu'elle date
              de trois minutes.

              Pourquoi regrouper au lieu de vider chaque champ : la dernière
              valeur connue reste lisible, mais visiblement inerte. C'est plus
              utile que des « — » partout : on sait encore où on était.
            -->
            <LinearLayout
                android:id="@+id/grpPosition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/Row">
                    <TextView style="@style/Label" android:text="@string/label_latitude" />
                    <TextView android:id="@+id/tvLat" style="@style/Value" />
                </LinearLayout>

                <LinearLayout style="@style/Row">
                    <TextView style="@style/Label" android:text="@string/label_longitude" />
                    <TextView android:id="@+id/tvLon" style="@style/Value" />
                </LinearLayout>

                <LinearLayout style="@style/Row">
                    <TextView style="@style/Label" android:text="@string/label_altitude" />
                    <TextView android:id="@+id/tvAlt" style="@style/Value" />
                </LinearLayout>

                <LinearLayout style="@style/Row">
                    <TextView style="@style/Label" android:text="@string/label_accuracy" />
                    <TextView android:id="@+id/tvAcc" style="@style/Value" />
                </LinearLayout>
            </LinearLayout>

            <!-- Datum : sélecteur + position convertie -->
            <TextView style="@style/LabelSmall" android:text="@string/label_datum" />

            <Spinner
                android:id="@+id/spDatum"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:backgroundTint="@color/gps_green_dim" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_datum_pos" />
                <TextView android:id="@+id/tvDatumPos" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_utm" />
                <TextView android:id="@+id/tvUtm" style="@style/Value" />
            </LinearLayout>

            <!-- ============ SIGNAL ============ -->
            <TextView style="@style/SectionTitle" android:text="@string/section_signal" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_satellites" />
                <TextView android:id="@+id/tvSats" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_bands" />
                <TextView android:id="@+id/tvBands" style="@style/Value" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBandSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/gps_amber"
                android:textSize="11sp"
                android:text="@string/band_detecting" />

            <TextView
                android:id="@+id/tvConstellationSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/gps_text_dim"
                android:textSize="10sp" />

            <!-- Sélecteur de filtre : Tous / Utilisés / par constellation -->
            <Spinner
                android:id="@+id/spSatFilter"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="@color/gps_green_dim" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_fix_quality" />
                <TextView android:id="@+id/tvFixQuality" style="@style/Value" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbSnr"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progressTint="@color/gps_green"
                android:progressBackgroundTint="@color/gps_card" />

            <ListView
                android:id="@+id/lvSatellites"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/list_bg"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="vertical" />

            <!-- ============ DOP : la vraie mesure de qualité ============ -->
            <TextView style="@style/SectionTitle" android:text="@string/section_dop" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_pdop" />
                <TextView android:id="@+id/tvPdop" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_hdop" />
                <TextView android:id="@+id/tvHdop" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_vdop" />
                <TextView android:id="@+id/tvVdop" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_dop_compare" />
                <TextView android:id="@+id/tvDopCompare" style="@style/ValueSmall" />
            </LinearLayout>

            <!-- ============ VITESSE / CAP / BOUSSOLE ============ -->
            <TextView style="@style/SectionTitle" android:text="@string/section_velocity" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_speed" />
                <TextView android:id="@+id/tvSpeed" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_bearing" />
                <TextView android:id="@+id/tvBearing" style="@style/Value" />
            </LinearLayout>

            <!-- LE CADRAN REMPLACE LA LIGNE DE TEXTE « Boussole ».
                 La v5.13 affichait « Nord-Est (045°) » sur une ligne, et
                 c'est exactement ce que le cadran affiche désormais au
                 centre. Garder les deux, c'était la même information deux
                 fois à dix lignes d'intervalle. La TextView est conservée
                 pour les lecteurs d'écran (contentDescription du cadran),
                 mais masquée. -->

            <!-- Cadran dessiné au Canvas (v5.14). Masqué tant qu'aucun
                 azimut n'est disponible : afficher un cadran figé serait
                 une information fausse, pas une information vide. La
                 visibilité est pilotée par MainActivity. -->
            <TextView
                android:id="@+id/tvCompass"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:visibility="gone" />

            <com.example.gpstest.CompassView
                android:id="@+id/compassView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:contentDescription="@string/label_compass"
                android:visibility="gone" />

            <!-- Dit explicitement pourquoi le cadran est absent. -->
            <TextView
                android:id="@+id/tvCompassNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/gps_text_dim"
                android:textSize="11sp"
                android:visibility="gone" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_compass_north_ref" />
                <TextView android:id="@+id/tvCompassNorth" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_declination" />
                <TextView android:id="@+id/tvDeclination" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_nmea_speed" />
                <TextView android:id="@+id/tvNmeaSpeed" style="@style/Value" />
            </LinearLayout>

            <!-- ============ CARTE DU CIEL ============ -->
            <TextView style="@style/SectionTitle" android:text="@string/section_sky" />

            <com.example.gpstest.SkyView
                android:id="@+id/skyView"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="4dp" />

            <!-- ============ TEMPS ============ -->
            <TextView style="@style/SectionTitle" android:text="@string/section_time" />

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_ttff" />
                <TextView android:id="@+id/tvTtff" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_elapsed" />
                <TextView android:id="@+id/tvElapsed" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_max_sats" />
                <TextView android:id="@+id/tvMaxSats" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_max_snr" />
                <TextView android:id="@+id/tvMaxSnr" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_gps_time" />
                <TextView android:id="@+id/tvGpsTime" style="@style/Value" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_sun" />
                <TextView android:id="@+id/tvSun" style="@style/ValueSmall" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_moon" />
                <TextView android:id="@+id/tvMoon" style="@style/ValueSmall" />
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <TextView style="@style/Label" android:text="@string/label_gpx" />
                <TextView android:id="@+id/tvGpx" style="@style/Value" />
            </LinearLayout>

            <!-- DESTINATION, VISIBLE EN PERMANENCE PENDANT L'ENREGISTREMENT.
                 Répond à « où va ma trace ? » sans quitter l'écran principal.
                 UNE seule vue, pas deux : un libellé et sa valeur dans le même
                 bloc vertical, et la ligne entière est masquée quand la
                 destination est le dossier privé (chemin invisible pour
                 l'utilisateur, donc rien d'utile à montrer). -->
            <LinearLayout
                android:id="@+id/rowDest"
                style="@style/Row"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Label"
                    android:text="@string/label_dest" />

                <TextView
                    android:id="@+id/tvDest"
                    style="@style/ValueSmall"
                    android:textColor="@color/gps_text_dim" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
