    <string name="data_share_failed">Aucune trace à partager.</string>
    <string name="warn_gpx_applied">GPX %1$s : appliqué au prochain segment de trace.</string>
    <string name="warn_policy_suspend">Trou assumé : chaque reprise après extinction ouvre un NOUVEAU fichier GPX (-p2, -p3…). Deux fichiers honnêtes valent mieux qu\'une trace trouée.</string>
    <string name="warn_policy_keep_on">L\'écran reste allumé tant que l\'app est visible. Batterie : c\'est le poste de consommation le plus lourd.</string>
    <string name="warn_policy_continue">Les points continuent d\'arriver écran éteint. La notification permanente indique que le suivi est actif.</string>

    <!-- Écran Réglages -->
    <string name="settings_title">Réglages</string>
    <string name="settings_section_background">COMPORTEMENT ÉCRAN ÉTEINT</string>
    <string name="settings_section_gpx">FORMAT DE TRACE GPX</string>
    <string name="settings_background_intro">Quand l\'écran s\'éteint, l\'application peut continuer à enregistrer ou se mettre en pause. Le prix se paie en batterie.</string>
    <string name="settings_gpx_intro">Deux versions du même format : 1.0 pour les outils anciens, 1.1 pour le standard actuel.</string>
    <string name="settings_note_non_persistant">Ces réglages sont enregistrés sur l\'appareil et conservés d\'une session à l\'autre.</string>

