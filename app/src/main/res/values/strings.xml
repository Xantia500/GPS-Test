    <string name="dest_lost">Le dossier choisi n\'est plus accessible. Les traces restent enregistrées dans le dossier de l\'application, rien n\'est perdu.</string>
    <string name="dest_app_warning">Ce dossier est privé : il disparaît si vous désinstallez l\'application, et il est invisible dans la plupart des gestionnaires de fichiers.</string>
    <string name="dest_set_ok">Destination enregistrée : %1$s</string>
    <string name="dest_set_failed">Impossible d\'écrire dans ce dossier. Choisissez-en un autre.</string>

