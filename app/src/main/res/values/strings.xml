    <string name="theme_section">APPARENCE</string>
    <string name="theme_intro">Par défaut, l\'application suit le mode clair ou sombre de votre téléphone. Vous pouvez forcer l\'un des deux.</string>
    <string name="theme_system">Suivre le téléphone</string>
    <string name="theme_light">Clair</string>
    <string name="theme_dark">Sombre</string>
    <string name="theme_system_desc">L\'application change automatiquement : claire le jour, sombre la nuit, comme le reste de votre téléphone.</string>
    <string name="theme_light_desc">Toujours clair. Plus lisible en plein soleil.</string>
    <string name="theme_dark_desc">Toujours sombre. Repose les yeux la nuit et dans une voiture.</string>
    <!-- ══════════ v5.6 : perte de signal, unités ══════════ -->
    <string name="status_signal_lost">Signal GPS perdu depuis %1$d s</string>
    <string name="settings_units_section">UNITÉS</string>
    <string name="settings_units_intro">Choisissez le système d\'unités affiché. Les traces GPX restent toujours en unités internationales (mètres, degrés) : c\'est la norme.</string>
    <string name="units_metric">Métrique (m, km, km/h)</string>
    <string name="units_imperial">Impérial (ft, mi, mph)</string>
    <string name="units_nautical">Maritime (m, NM, nœuds)</string>
    <string name="settings_voice_section">ALERTES VOCALES</string>
    <string name="settings_voice_intro">En cas de perte du signal GPS, l\'application vous prévient à voix haute, dans la langue de votre téléphone. Le premier avertissement arrive après le délai choisi ci-dessous : un passage sous un pont ou un arbre ne déclenche donc rien.</string>
    <string name="settings_voice_toggle">Annoncer la perte de signal GPS</string>
    <string name="settings_voice_desc">Le premier intervalle sert de délai d\'attente. Le retour du signal n\'est annoncé qu\'une fois, et seulement s\'il se maintient.</string>
    <string name="settings_voice_unavailable">Synthèse vocale indisponible sur cet appareil.</string>
    <string name="settings_voice_repeat_label">Rappeler la perte de signal</string>
    <string name="settings_voice_max_label">Nombre maximal d\'alertes par perte</string>
    <string name="settings_voice_recovery">Annoncer aussi le retour du signal</string>
    <string name="voice_repeat_never">Jamais (une seule alerte)</string>
    <string name="voice_repeat_30s">Toutes les 30 s</string>
    <string name="voice_repeat_1min">Toutes les minutes</string>
    <string name="voice_repeat_2min">Toutes les 2 minutes</string>
    <string name="voice_repeat_5min">Toutes les 5 minutes</string>
    <string name="voice_max_1">1 fois</string>
    <string name="voice_max_3">3 fois</string>
    <string name="voice_max_5">5 fois</string>
    <string name="voice_max_10">10 fois</string>
    <string name="voice_max_inf">Sans limite</string>
