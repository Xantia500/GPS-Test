    <string name="settings_compass_section">BOUSSOLE</string>
    <string name="settings_compass_intro">Le capteur de rotation donne un cap MAGNÉTIQUE. Le nord magnétique s\'écarte du nord géographique d\'un angle appelé déclinaison, qui dépend du lieu : environ +1,5° à Paris, −14° à Montréal, +15° à Vancouver. Choisissez le nord auquel vous voulez lire vos caps.</string>
    <string name="compass_north_magnetic">Nord magnétique (brut du capteur)</string>
    <string name="compass_north_true">Nord vrai (corrigé de la déclinaison)</string>
    <string name="compass_north_true_note">La déclinaison est calculée à la position courante ; sans position, le cap reste magnétique et l\'écran le signale.</string>
    <string name="compass_tilted">Appareil incliné à %.0f° : cap peu fiable, tenez-le à plat</string>
    <string name="compass_magnetic_disturbed">Champ magnétique perturbé : éloignez-vous de toute masse métallique</string>
