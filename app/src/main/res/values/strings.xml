    <string name="settings_section_data">DONNÉES ENREGISTRÉES</string>
    <string name="data_storage_explanation">Les traces et mesures sont stockées dans le dossier privé de l\'application. Elles sont conservées jusqu\'à leur suppression et ne sont jamais envoyées sur Internet.</string>
    <string name="data_none">Aucun fichier pour le moment.</string>
