    <!-- ══════════ v5.10 : espacement des points ══════════ -->
    <string name="settings_sampling_section">POINTS ENREGISTRÉS</string>
    <string name="settings_sampling_intro">Deux critères indépendants. Un point est écrit dès que l\'UN OU L\'AUTRE est atteint — jamais les deux à la fois, sinon une trace serait presque vide quand vous ralentissez.</string>
    <string name="settings_sampling_distance">Distance minimale entre deux points</string>
    <string name="settings_sampling_time">Temps maximal entre deux points</string>
    <string name="sampling_distance_none">Aucune (tout enregistrer)</string>
    <string name="sampling_time_none">Aucun</string>
    <string name="mode_section">MODE D\'ENREGISTREMENT</string>
    <string name="mode_intro">Le mode fixe à quel point la trace est détaillée. En marche, on avance lentement : un point tous les 20 m suffit. En voiture, 50 m. Choisissez « Personnalisé » pour régler les deux valeurs vous-même.</string>
    <string name="mode_walk">Marche / randonnée</string>
    <string name="mode_bike">VTT / cyclisme</string>
    <string name="mode_car">Véhicule motorisé</string>
    <string name="mode_custom">Personnalisé</string>
    <string name="mode_custom_hint">Les deux réglages ci-dessous ne s\'appliquent qu\'en mode personnalisé.</string>
    <string name="mode_summary">%1$s — un point tous les %2$s (ou toutes les %3$s)</string>
    <string name="mode_accuracy">Précision minimale acceptée : %1$s. Au-delà, le point est écarté.</string>
    <string name="mode_pp_section">NETTOYAGE À LA FIN</string>
    <string name="mode_pp_intro">À la fin d\'une session, une copie nettoyée de la trace est créée à côté de l\'original, qui n\'est jamais modifié. Le nettoyage retire les points aberrants et simplifie la trace en gardant sa forme.</string>
    <string name="mode_pp_enabled">Nettoyer la trace à la fin</string>
    <string name="mode_pp_tolerance">Simplification (Douglas-Peucker), tolérance</string>
    <string name="mode_pp_off">Aucune simplification</string>
    <string name="expert_csv_saved_title">Mesures enregistrées</string>
    <string name="expert_csv_saved_message">Fichier créé :\n\n%1$s\n\n%2$d octets.\n\nIl est dans le même dossier que vos traces GPX. Vous pouvez le récupérer depuis les réglages (« Fichiers ») ou en branchant le téléphone en USB.</string>
    <string name="expert_csv_ok">Compris</string>
    <string name="mode_reject_banner">Point non enregistré \u2014 %1$s (mode %2$s)</string>
    <string name="sampling_hint">Un fichier de 2 h en marche rapide fait environ 400 points avec ces réglages, contre 7 200 sans filtre.</string>

